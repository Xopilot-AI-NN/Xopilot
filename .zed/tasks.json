[
  {
    "label": "Xopilot: Cargo Check (desktop)",
    "command": "cargo",
    "args": [
      "check",
      "-p",
      "xopilot",
      "--locked"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "hide": "on_success"
  },
  {
    "label": "Xopilot: Cargo Check (workspace)",
    "command": "cargo",
    "args": [
      "check",
      "--workspace",
      "--locked"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "hide": "on_success"
  },
  {
    "label": "Xopilot: Rustfmt Check",
    "command": "cargo",
    "args": [
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "hide": "on_success"
  },
  {
    "label": "Xopilot: Rustfmt Apply",
    "command": "cargo",
    "args": [
      "fmt",
      "--all"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "hide": "on_success"
  },
  {
    "label": "Xopilot: Tests Quick",
    "command": "bash",
    "args": [
      "./scripts/test.sh",
      "quick"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Xopilot: Tests UI",
    "command": "bash",
    "args": [
      "./scripts/test.sh",
      "ui"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Xopilot: Dioxus Desktop",
    "command": "dx",
    "args": [
      "serve",
      "--desktop",
      "--package",
      "xopilot"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "use_new_terminal": true
  }
]
